# Deny all direct web access to the config directory (Apache).
# Sensitive data files (auth.php, settings.php, recipients.php) live here.
# They are also PHP files that return arrays, so even a raw fetch yields
# nothing — this is a second line of defence.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
